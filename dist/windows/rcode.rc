// GPUI's Windows platform loads the application icon from resource ID 1.
1 ICON "rcode.ico"

1 VERSIONINFO
FILEVERSION RCODE_FILE_VERSION
PRODUCTVERSION RCODE_FILE_VERSION
FILEOS 0x00040004L
FILETYPE 0x00000001L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "RCode\0"
            VALUE "FileVersion", RCODE_VERSION
            VALUE "ProductName", "RCode\0"
            VALUE "ProductVersion", RCODE_VERSION
            VALUE "InternalName", "rcode\0"
            VALUE "OriginalFilename", "rcode.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
